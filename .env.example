# postgreSQL
DB_URL=jdbc:postgresql://localhost:5432/smarthouse
DB_USERNAME=postgres
DB_PASSWORD=

# chaves de API
# gerar com o comando: openssl rand -hex 24 (rodar duas vezes, um valor para cada variável)
DEVICE_API_KEY=
ADMIN_API_KEY=

# MQTT
MQTT_ENABLED=true
MQTT_BROKER_URL=tcp://broker.hivemq.com:1883
MQTT_TOPIC=kamyla-fag/smarthouse/+/readings
MQTT_CONFIG_TOPIC=kamyla-fag/smarthouse/config
MQTT_HEATER_TOPIC=kamyla-fag/smarthouse/%s/heater/set
MQTT_USERNAME=
MQTT_PASSWORD=

CORS_ALLOWED_ORIGINS=http://localhost:5173
